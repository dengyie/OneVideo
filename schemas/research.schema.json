{
  "$id": "onevideo/research",
  "title": "plan/research.json — sourced facts",
  "type": "object",
  "required": ["topic", "asOf", "facts"],
  "additionalProperties": false,
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "question": { "type": "string" },
    "audience": { "type": "string" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "allowNumbers": { "type": "array", "items": { "type": ["string", "number"] } },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" }, "date": { "type": "string" }, "publisher": { "type": "string" } }
    },
    "fact": {
      "type": "object",
      "required": ["id", "claim", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "claim": { "type": "string", "minLength": 4 },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "quote": { "type": "string" },
        "confidence": { "enum": ["confirmed", "reported", "estimate"] },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
