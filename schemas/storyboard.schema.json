{
  "$id": "onevideo/storyboard",
  "title": "plan/storyboard.json — visuals per scene (types = template scene components)",
  "type": "object",
  "required": [
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "transitionType": {
      "enum": ["fade", "slide", "push", "whip", "zoom", "punch", "iris", "wipe", "clock", "dip", "cut"]
    },
    "transition": {
      "oneOf": [
        { "$ref": "#/$defs/transitionType" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/transitionType" },
            "duration": { "type": "number", "minimum": 0, "maximum": 2 },
            "direction": { "enum": ["left", "right", "up", "down"] },
            "sfx": { "type": ["string", "null"], "description": "sound for this boundary; null silences it" }
          }
        }
      ]
    },
    "camera": {
      "oneOf": [
        { "$ref": "#/$defs/cameraMove" },
        {
          "type": "object",
          "required": ["move"],
          "additionalProperties": false,
          "properties": {
            "move": { "$ref": "#/$defs/cameraMove" },
            "amount": { "type": "number", "minimum": 0, "maximum": 3 }
          }
        }
      ]
    },
    "cameraMove": {
      "enum": ["static", "drift", "push", "pull", "pan-left", "pan-right", "rise", "handheld"]
    },
    "at": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "phrase"
          ],
          "additionalProperties": false,
          "properties": {
            "phrase": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "number"
            }
          }
        }
      ]
    },
    "compareSide": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "compact": {
              "enum": [
                "none",
                "zh",
                "en"
              ]
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
        },
        "asset": {
          "type": "string"
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "type": {
          "enum": [
            "title",
            "chapter",
            "stat-cards",
            "bar-compare",
            "bar-race",
            "line-chart",
            "share",
            "timeline",
            "quote",
            "bullets",
            "media",
            "compare",
            "sources"
          ]
        },
        "props": {
          "type": "object"
        },
        "header": {
          "type": "object",
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          }
        },
        "chapter": {
          "type": "string"
        },
        "cues": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/at"
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sound"
            ],
            "additionalProperties": false,
            "properties": {
              "sound": {
                "enum": [
                  "whoosh",
                  "tick",
                  "impact",
                  "riser",
                  "pop",
                  "chime"
                ]
              },
              "at": {
                "$ref": "#/$defs/at"
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "enter": {
          "$ref": "#/$defs/transition",
          "description": "transition into this scene; wins over the previous scene's exit"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "exit": {
          "$ref": "#/$defs/transition"
        },
        "duration": {
          "type": "number",
          "minimum": 0.5
        },
        "minDuration": {
          "type": "number",
          "minimum": 0.5
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "background": {
          "enum": [
            "default",
            "plain",
            "grid",
            "stars",
            "media"
          ]
        },
        "backdrop": {
          "description": "Full-bleed photo or footage behind the scene (charts sit on frosted cards above it).",
          "type": "object",
          "additionalProperties": false,
          "required": ["asset"],
          "properties": {
            "asset": { "type": "string" },
            "dim": { "type": "number", "minimum": 0, "maximum": 1 },
            "blur": { "type": "number", "minimum": 0, "maximum": 40 },
            "motion": { "enum": ["in", "out", "left", "right", "up", "none"] },
            "startFrom": { "type": "number", "minimum": 0 }
          }
        },
        "captions": {
          "type": "boolean"
        },
        "intent": {
          "type": "string"
        }
      }
    }
  },
  "props": {
    "title": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "kicker": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "chapter": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": [
            "integer",
            "string"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        }
      }
    },
    "stat-cards": {
      "type": "object",
      "required": [
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "from": {
                "type": "number"
              },
              "format": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "suffix": {
                    "type": "string"
                  },
                  "decimals": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "compact": {
                    "enum": [
                      "none",
                      "zh",
                      "en"
                    ]
                  }
                }
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
              },
              "cue": {
                "type": "string",
                "description": "name of a cue in scene.cues; the item appears when it resolves"
              }
            }
          }
        }
      }
    },
    "bar-compare": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "compact": {
              "enum": [
                "none",
                "zh",
                "en"
              ]
            }
          }
        },
        "sort": {
          "enum": [
            "none",
            "desc",
            "asc"
          ]
        },
        "max": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
              },
              "highlight": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              },
              "cue": {
                "type": "string",
                "description": "name of a cue in scene.cues; the item appears when it resolves"
              }
            }
          }
        }
      }
    },
    "bar-race": {
      "type": "object",
      "required": [
        "periods",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "compact": {
              "enum": [
                "none",
                "zh",
                "en"
              ]
            }
          }
        },
        "top": {
          "type": "integer",
          "minimum": 2,
          "maximum": 15
        },
        "periods": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "values"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
              },
              "group": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "groupColors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
          }
        },
        "periodCues": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "cue name per period (null = auto); the race reaches period k when its cue resolves"
        }
      }
    },
    "line-chart": {
      "type": "object",
      "required": [
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "compact": {
              "enum": [
                "none",
                "zh",
                "en"
              ]
            }
          }
        },
        "yMin": {
          "type": "number"
        },
        "yMax": {
          "type": "number"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "name",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              }
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "label": {
                "type": "string"
              },
              "series": {
                "type": "integer",
                "minimum": 0
              },
              "cue": {
                "type": "string",
                "description": "name of a cue in scene.cues; the item appears when it resolves"
              }
            }
          }
        },
        "drawCue": {
          "type": "string",
          "description": "name of a cue in scene.cues; the item appears when it resolves"
        }
      }
    },
    "share": {
      "type": "object",
      "required": [
        "segments"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "compact": {
              "enum": [
                "none",
                "zh",
                "en"
              ]
            }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-z]+)$"
              },
              "cue": {
                "type": "string",
                "description": "name of a cue in scene.cues; the item appears when it resolves"
              }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "date",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "highlight": {
                "type": "boolean"
              },
              "cue": {
                "type": "string",
                "description": "name of a cue in scene.cues; the item appears when it resolves"
              }
            }
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        }
      }
    },
    "bullets": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "cue": {
                    "type": "string",
                    "description": "name of a cue in scene.cues; the item appears when it resolves"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "asset"
      ],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "motion": {
          "enum": [
            "in",
            "out",
            "left",
            "right",
            "up",
            "none"
          ]
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "startFrom": {
          "type": "number"
        },
        "muted": {
          "type": "boolean"
        }
      }
    },
    "compare": {
      "type": "object",
      "required": [
        "left",
        "right"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "vs": {
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/compareSide"
        },
        "right": {
          "$ref": "#/$defs/compareSide"
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto": {
          "type": "boolean"
        }
      }
    }
  }
}
