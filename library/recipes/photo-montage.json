{
  "name": "photo-montage",
  "title": "快门照片蒙太奇",
  "description": "3–5 张照片依次叠放，每张落下配快门声",
  "tags": [
    "photo-stack",
    "照片",
    "蒙太奇"
  ],
  "scenes": [
    {
      "type": "photo-stack",
      "props": {
        "title": "{{title}}",
        "items": [
          {
            "asset": "{{photo1}}",
            "caption": "{{caption1}}"
          },
          {
            "asset": "{{photo2}}",
            "caption": "{{caption2}}"
          },
          {
            "asset": "{{photo3}}",
            "caption": "{{caption3}}"
          }
        ]
      },
      "sfx": [
        {
          "sound": "shutter",
          "at": 0.3
        },
        {
          "sound": "shutter",
          "at": 1.3
        },
        {
          "sound": "shutter",
          "at": 2.3
        }
      ]
    }
  ]
}
