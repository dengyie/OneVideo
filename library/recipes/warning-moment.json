          "at": 0.4,
          "x": 0.88,
          "y": 0.18,
          "size": 140,
          "sfx": "auto"
        },
        {
          "type": "mark",
          "kind": "strike",
          "rect": [
            0.12,
            0.6,
            0.5,
            0.06
          ],
          "at": 2.6,
          "color": "#ff4d4f",
          "sfx": "auto"
        }
      ]
    }
  ],
  "notes": "mark.rect / arrow.from-to / callout.x-y / spotlight.x-y 是画面比例坐标，按实际内容微调后跑 onevideo stills 核对"
