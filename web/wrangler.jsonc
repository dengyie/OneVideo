// Static player for published OneVideo renders. `npm run web:deploy` (repo root) syncs media and deploys; on the render node it reads /srv/onevideo directly.
{
  "name": "onevideo-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/v/*"] },
  "routes": [{ "pattern": "vedio.mangoqwq.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
